{
  "name": "dsh-web-fetch-fakeip",
  "version": "0.1.1-alpha.1",
  "description": "fake-ip-aware WebFetchProvider for the DeepSeek Harness web seam — keeps the web_fetch tool working under mihomo/Clash fake-ip DNS without disabling fake-ip or setting proxy environment variables.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./scripts/diagnose.mjs": "./scripts/diagnose.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "scripts",
    "test",
    "cordis.patch.yml",
    "examples",
    "README.md",
    "README.zh.md",
    "RELEASING.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "web-fetch",
    "fake-ip",
    "mihomo",
    "clash",
    "tun",
    "proxy",
    "ssrf"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaminn/dsh-web-fetch-fakeip.git"
  },
  "homepage": "https://github.com/kaminn/dsh-web-fetch-fakeip#readme",
  "bugs": {
    "url": "https://github.com/kaminn/dsh-web-fetch-fakeip/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:live": "node --test \"test/**/*.live.js\"",
    "check": "node --check src/index.js && node --check src/config.js && node --check src/resolver.js && npm test",
    "verify": "npm run check && npm run pack:check",
    "pack:check": "node scripts/check-package.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "ipaddr.js": "^2.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-web": "0.1.2-rc.1 || 0.1.3-alpha.2 || 0.1.5-alpha.1 || 0.1.5-alpha.2 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-web-fetch-http": "0.1.2-rc.1 || 0.1.3-alpha.2 || 0.1.5-alpha.1 || 0.1.5-alpha.2 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2",
    "@deepseek-ai/schemastery": ">=3.18.2 <4.0.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-web": "0.1.5-rc.2",
    "@deepseek-ai/dsh-web-fetch-http": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2"
  }
}
